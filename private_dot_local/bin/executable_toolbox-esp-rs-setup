#!/usr/bin/env bash
# Sets up the esp-rs tooling from
# https://docs.espressif.com/projects/rust/book/getting-started/tooling/
# inside a Fedora toolbox: espup, espflash and probe-rs-tools all pull in
# openssl-sys with the `vendored` feature (so they always compile their own
# OpenSSL, ignoring system openssl-devel), and that vendored build's
# Configure/Makefile.in scripts need several Perl modules Fedora ships as
# separate subpackages rather than bundling with the base perl-interpreter.
#
# espflash and probe-rs-tools are installed via cargo-binstall (prebuilt
# release binaries) instead, sidestepping that build entirely -- espup has
# no prebuilt release, so it still needs the Perl/OpenSSL packages below.
#
# Run probe-rs-udev-setup separately, on the HOST, for probe/board access.
set -euo pipefail

if [ ! -e /run/.containerenv ]; then
  echo "Refusing to run outside a toolbox/container." >&2
  exit 1
fi

sudo dnf install -y \
  openssl-devel \
  perl-FindBin \
  perl-IPC-Cmd \
  perl-Test-Simple \
  perl-File-Copy \
  perl-File-Compare \
  perl-Time-Piece

if ! command -v cargo-binstall >/dev/null 2>&1; then
  curl -L --proto '=https' --tlsv1.2 -sSf \
    https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh \
    | bash
fi

cargo binstall -y espflash probe-rs-tools

echo "Done -- 'cargo install espup' should now build cleanly, and espflash/probe-rs are ready."
